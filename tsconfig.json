// tsconfig.json (프로젝트 루트)
{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "jsx": "react-native",           
    "strict": true,
    "moduleResolution": "node",
    "allowJs": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "App.tsx",
    "screens/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "meeting/**/*.{ts,tsx}"
  ],
  "exclude": ["node_modules"]
}
